{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true, "noEmit": true, "esModuleInterop": true,
    "types": ["bun-types", "vite/client"], "resolveJsonModule": true, "isolatedModules": true, "allowImportingTsExtensions": false
  },
  "include": ["src", "vite.config.ts"]
}
